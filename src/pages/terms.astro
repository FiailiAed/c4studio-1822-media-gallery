---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
---

<BaseLayout title={`Terms of Service — ${brand.name}`} description="Terms of service for 1822 Media.">
  <Header slot="header" />

  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <h1 class="text-h1 font-heading font-bold uppercase text-primary mb-8">Terms of Service</h1>
    <div class="prose text-text space-y-4">
      <p class="text-text-muted">Last updated: May 2025</p>
      <p>By purchasing or accessing a 1822 Media event gallery, you agree to use the photos and media for personal, non-commercial purposes only.</p>
      <p>Access codes are issued per-purchase and are non-transferable. Sharing codes with individuals outside your team or organization is not permitted.</p>
      <p>All media remains the intellectual property of 1822 Media. Redistribution, resale, or commercial use without written consent is prohibited.</p>
      <p>Refund requests must be submitted within 7 days of purchase. Contact <a href="mailto:1822lax@gmail.com" class="text-primary hover:underline">1822lax@gmail.com</a>.</p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
