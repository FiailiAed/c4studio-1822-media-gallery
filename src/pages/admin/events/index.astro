---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SignOutButton } from '@clerk/astro/components';
import { brand } from '../../../config/brand';
---

<BaseLayout title={`Events — Admin — ${brand.name}`} description="Manage all events.">
  <Header slot="header" />

  <section class="min-h-screen bg-surface py-10">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <a href="/admin" class="text-sm text-text-muted hover:text-primary transition-colors">&larr; Dashboard</a>
          <h1 class="mt-2 text-h1 font-heading font-bold uppercase text-primary">All Events</h1>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/admin/events/new"
            class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg transition-opacity hover:opacity-90"
          >
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            New Event
          </a>
          <SignOutButton
            redirectUrl="/"
            class="inline-flex items-center rounded-md border border-border px-4 py-2.5 text-sm font-medium text-text-muted hover:text-text hover:bg-surface transition-colors"
          >
            Sign Out
          </SignOutButton>
        </div>
      </div>

      <div id="events-loading" class="animate-pulse space-y-3">
        {Array.from({ length: 5 }).map(() => (
          <div class="h-20 rounded-xl border border-border bg-background"></div>
        ))}
      </div>

      <div id="events-list" class="hidden space-y-3"></div>

      <div id="events-empty" class="hidden rounded-xl border border-border bg-background p-12 text-center">
        <p class="text-text-muted">No events yet.</p>
        <a href="/admin/events/new" class="mt-3 inline-block text-sm font-semibold text-primary hover:underline">Create your first event</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import { ConvexClient } from 'convex/browser';
  import { $sessionStore } from '@clerk/astro/client';
  import { api } from '../../../../convex/_generated/api';

  const convex = new ConvexClient(import.meta.env.PUBLIC_CONVEX_URL as string);

  function formatDate(ts: number): string {
    return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(ts));
  }

  let initialized = false;
  $sessionStore.subscribe((session) => {
    if (!session || initialized) return;
    initialized = true;

    convex.setAuth((forceRefresh) =>
      (session as any).getToken({ template: 'convex', skipCache: forceRefresh ?? false }).then((t: string | null) => t ?? null)
    );

    convex.onUpdate(api.events.listAll, {}, (events) => {
      document.getElementById('events-loading')!.classList.add('hidden');
      const list = document.getElementById('events-list')!;
      const empty = document.getElementById('events-empty')!;

      if (!events || events.length === 0) {
        empty.classList.remove('hidden');
        return;
      }
      list.classList.remove('hidden');
      list.innerHTML = events.map((e: any) => `
        <a href="/admin/events/${e._id}" class="flex items-center justify-between rounded-xl border border-border bg-background px-5 py-4 hover:border-accent transition-colors group">
          <div>
            <p class="font-semibold text-text group-hover:text-primary">${e.title}</p>
            <p class="mt-0.5 text-sm text-text-muted">
              ${formatDate(e.eventDate)}
              ${e.location ? ` &middot; ${e.location}` : ''}
              &middot; ${e.mediaCount} photos
            </p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs rounded-full px-2.5 py-1 font-medium ${e.isFree ? 'bg-border text-text-muted' : 'bg-primary/10 text-primary'}">
              ${e.isFree ? 'Free' : 'Paid'}
            </span>
            <span class="text-xs rounded-full px-2.5 py-1 font-medium ${e.isPublished ? 'bg-accent/20 text-primary' : 'bg-border text-text-muted'}">
              ${e.isPublished ? 'Published' : 'Draft'}
            </span>
          </div>
        </a>
      `).join('');
    });
  });
</script>
