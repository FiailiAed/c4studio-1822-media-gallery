---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SignOutButton } from '@clerk/astro/components';
import { brand } from '../../../config/brand';

const { id } = Astro.params;
---

<BaseLayout title={`Edit Event — Admin — ${brand.name}`} description="Edit event, upload media, manage access codes.">
  <Header slot="header" />

  <!-- Pass event ID to client script via data attribute -->
  <section class="min-h-screen bg-surface py-10" data-event-id={id}>
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mb-6 flex items-start justify-between">
        <div>
          <a href="/admin/events" class="text-sm text-text-muted hover:text-primary transition-colors">&larr; All Events</a>
          <div id="event-title-bar" class="mt-2">
            <div id="title-skeleton" class="animate-pulse h-8 w-64 rounded bg-border"></div>
            <div id="title-content" class="hidden flex items-center gap-3">
              <h1 id="page-title" class="text-h1 font-heading font-bold uppercase text-primary"></h1>
              <a id="view-gallery-link" href="#" class="text-sm text-primary hover:underline" target="_blank">View gallery &rarr;</a>
            </div>
          </div>
        </div>
        <SignOutButton
          redirectUrl="/"
          class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium text-text-muted hover:text-text hover:bg-surface transition-colors mt-1"
        >
          Sign Out
        </SignOutButton>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        <!-- Left column: event details + media upload -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Event details form -->
          <div class="rounded-xl border border-border bg-background p-6">
            <h2 class="text-h3 font-heading font-bold uppercase text-primary mb-4">Event Details</h2>
            <form id="event-edit-form" class="space-y-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="edit-title" class="block text-sm font-medium text-text">Title</label>
                  <input id="edit-title" type="text" class="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text focus:border-accent focus:outline-none" />
                </div>
                <div>
                  <label for="edit-location" class="block text-sm font-medium text-text">Location</label>
                  <input id="edit-location" type="text" class="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text focus:border-accent focus:outline-none" />
                </div>
              </div>
              <div>
                <label for="edit-date" class="block text-sm font-medium text-text">Date</label>
                <input id="edit-date" type="date" class="mt-1 rounded-md border border-border bg-surface px-3 py-2 text-sm text-text focus:border-accent focus:outline-none" />
              </div>
              <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 text-sm text-text">
                  <input id="edit-published" type="checkbox" class="h-4 w-4 rounded border-border text-accent" />
                  Published
                </label>
                <label class="flex items-center gap-2 text-sm text-text">
                  <input id="edit-free" type="checkbox" class="h-4 w-4 rounded border-border text-accent" />
                  Free event
                </label>
              </div>
              <p id="edit-error" class="hidden text-sm text-red-600"></p>
              <button type="submit" class="rounded-md bg-accent px-4 py-2 text-sm font-bold text-accent-fg hover:opacity-90 disabled:opacity-50">
                Save Changes
              </button>
            </form>
          </div>

          <!-- Media upload -->
          <div class="rounded-xl border border-border bg-background p-6">
            <h2 class="text-h3 font-heading font-bold uppercase text-primary mb-4">Media</h2>

            <div
              id="upload-zone"
              class="rounded-lg border-2 border-dashed border-border p-8 text-center transition-colors hover:border-accent cursor-pointer"
            >
              <input type="file" id="file-input" multiple accept="image/*,video/*" class="hidden" />
              <svg class="mx-auto size-10 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <p class="mt-3 text-sm font-medium text-text">Click to upload or drag and drop</p>
              <p class="mt-1 text-xs text-text-muted">Images up to 16MB, videos up to 256MB</p>
            </div>

            <div id="upload-progress" class="mt-4 hidden space-y-2"></div>

            <!-- Add from Library -->
            <div class="mt-4 border-t border-border pt-4">
              <button
                id="library-toggle"
                class="flex w-full items-center gap-2 text-sm font-medium text-text-muted hover:text-primary transition-colors"
                aria-expanded="false"
              >
                <svg id="library-chevron" class="size-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                Add from Library
              </button>

              <div id="library-section" class="hidden mt-4">
                <div id="library-loading" class="hidden py-6 text-center text-sm text-text-muted animate-pulse">
                  Loading files...
                </div>
                <div id="library-empty" class="hidden py-6 text-center text-sm text-text-muted">
                  No files in UploadThing library.
                </div>
                <div id="library-grid" class="grid gap-2 grid-cols-4 sm:grid-cols-5 lg:grid-cols-6"></div>
                <div class="mt-3 flex items-center gap-3">
                  <button
                    id="library-add-btn"
                    class="hidden rounded-md bg-primary px-4 py-2 text-sm font-bold text-primary-fg transition-opacity hover:opacity-90 disabled:opacity-50"
                  >
                    Add Selected to Event
                  </button>
                  <span id="library-selected-count" class="hidden text-xs text-text-muted"></span>
                </div>
              </div>
            </div>

            <div id="media-list" class="mt-6 grid gap-3 grid-cols-3 sm:grid-cols-4 lg:grid-cols-5"></div>
          </div>
        </div>

        <!-- Right column: access codes -->
        <div class="space-y-4">
          <div class="rounded-xl border border-border bg-background p-6">
            <h2 class="text-h3 font-heading font-bold uppercase text-primary mb-4">Access Codes</h2>

            <button
              id="generate-code-btn"
              class="w-full rounded-md bg-primary px-4 py-2.5 text-sm font-bold text-primary-fg transition-opacity hover:opacity-90"
            >
              Generate New Code
            </button>

            <div id="codes-list" class="mt-4 space-y-2"></div>
            <div id="codes-empty" class="mt-4 hidden text-center text-sm text-text-muted py-4">
              No access codes yet.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import { ConvexClient } from 'convex/browser';
  import { $sessionStore } from '@clerk/astro/client';
  import { api } from '../../../../convex/_generated/api';
  import { genUploader } from 'uploadthing/client';
  import type { OurFileRouter } from '../../api/uploadthing';

  // Read event ID from data attribute (avoids define:vars + import conflict)
  const id = (document.querySelector('section[data-event-id]') as HTMLElement)?.dataset.eventId ?? '';

  const convex = new ConvexClient(import.meta.env.PUBLIC_CONVEX_URL as string);
  const { uploadFiles } = genUploader<OurFileRouter>({ package: 'uploadthing' });

  let currentEvent: any = null;
  let clerkSession: any = null;

  function formatDate(ts: number): string {
    return new Date(ts).toISOString().split('T')[0];
  }

  let initialized = false;
  $sessionStore.subscribe((session) => {
    if (!session || initialized) return;
    initialized = true;

    clerkSession = session;

    convex.setAuth((forceRefresh) =>
      (session as any).getToken({ template: 'convex', skipCache: forceRefresh ?? false }).then((t: string | null) => t ?? null)
    );

    // Load event data
    convex.onUpdate(api.events.get, { eventId: id as any }, (event) => {
      if (!event) return;
      currentEvent = event;

      document.getElementById('title-skeleton')!.classList.add('hidden');
      document.getElementById('title-content')!.classList.remove('hidden');
      (document.getElementById('page-title') as HTMLElement).textContent = event.title;
      (document.getElementById('view-gallery-link') as HTMLAnchorElement).href = `/gallery/${event.slug}`;

      (document.getElementById('edit-title') as HTMLInputElement).value = event.title;
      (document.getElementById('edit-location') as HTMLInputElement).value = event.location ?? '';
      (document.getElementById('edit-date') as HTMLInputElement).value = formatDate(event.eventDate);
      (document.getElementById('edit-published') as HTMLInputElement).checked = event.isPublished;
      (document.getElementById('edit-free') as HTMLInputElement).checked = event.isFree;
    });

    // Media list
    convex.onUpdate(api.media.listByEvent, { eventId: id as any }, (assets) => {
      const list = document.getElementById('media-list')!;
      if (!assets || assets.length === 0) {
        list.innerHTML = '';
        return;
      }
      list.innerHTML = (assets as any[]).map((a) => {
        const isVideo = a.mimeType?.startsWith('video/');
        const thumb = isVideo
          ? `<div class="absolute inset-0 bg-primary/10 flex items-center justify-center"><svg class="size-8 text-primary/40" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></div>`
          : `<img src="${a.uploadthingUrl}" alt="${a.filename}" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />`;
        return `
          <div class="group relative aspect-square overflow-hidden rounded-lg bg-surface">
            ${thumb}
            <button
              class="absolute top-1 right-1 hidden group-hover:flex h-7 w-7 items-center justify-center rounded-full bg-black/60 text-white hover:bg-red-600 transition-colors"
              data-asset-id="${a._id}"
              aria-label="Delete"
            >
              <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
        `;
      }).join('');

      list.querySelectorAll('[data-asset-id]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this photo?')) return;
          await convex.mutation(api.media.deleteAsset, { assetId: (btn as HTMLElement).dataset.assetId as any });
        });
      });
    });

    // Access codes
    convex.onUpdate(api.accessCodes.listByEvent, { eventId: id as any }, (codes) => {
      const list = document.getElementById('codes-list')!;
      const empty = document.getElementById('codes-empty')!;

      if (!codes || codes.length === 0) {
        list.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');
      list.innerHTML = (codes as any[]).map((c) => `
        <div class="flex items-center justify-between rounded-lg border border-border bg-surface px-3 py-2.5 ${c.isRevoked ? 'opacity-50' : ''}">
          <div>
            <p class="font-mono text-sm font-bold text-primary">${c.code}</p>
            ${c.label ? `<p class="text-xs text-text-muted">${c.label}</p>` : ''}
            <p class="text-xs text-text-muted">${c.usageCount} uses${c.maxUses ? ` / ${c.maxUses}` : ''}</p>
          </div>
          <div class="flex items-center gap-2">
            <button class="text-xs text-text-muted hover:text-primary" data-copy="${c.code}" title="Copy code">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            </button>
            ${!c.isRevoked ? `
              <button class="text-xs text-red-400 hover:text-red-600" data-revoke="${c._id}" title="Revoke">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
              </button>
            ` : '<span class="text-xs text-text-muted">Revoked</span>'}
          </div>
        </div>
      `).join('');

      list.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText((btn as HTMLElement).dataset.copy ?? '');
          (btn as HTMLElement).title = 'Copied!';
          setTimeout(() => { (btn as HTMLElement).title = 'Copy code'; }, 1500);
        });
      });

      list.querySelectorAll('[data-revoke]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!confirm('Revoke this code? Users with this code will lose access.')) return;
          await convex.mutation(api.accessCodes.revoke, { codeId: (btn as HTMLElement).dataset.revoke as any });
        });
      });
    });
  });

  // Edit form submit (auth already set via $sessionStore above)
  document.getElementById('event-edit-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = (e.currentTarget as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
    const errorEl = document.getElementById('edit-error')!;
    errorEl.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
      await convex.mutation(api.events.update, {
        eventId: id as any,
        title: (document.getElementById('edit-title') as HTMLInputElement).value.trim(),
        location: (document.getElementById('edit-location') as HTMLInputElement).value.trim() || undefined,
        eventDate: new Date((document.getElementById('edit-date') as HTMLInputElement).value).getTime(),
        isPublished: (document.getElementById('edit-published') as HTMLInputElement).checked,
        isFree: (document.getElementById('edit-free') as HTMLInputElement).checked,
      });
      btn.textContent = 'Saved!';
      setTimeout(() => { btn.textContent = 'Save Changes'; }, 2000);
    } catch (err) {
      errorEl.textContent = (err as Error)?.message ?? 'Failed to save.';
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
    }
  });

  // Generate code button
  document.getElementById('generate-code-btn')!.addEventListener('click', async () => {
    await convex.mutation(api.accessCodes.create, { eventId: id as any });
  });

  // Upload zone
  const uploadZone = document.getElementById('upload-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const progressEl = document.getElementById('upload-progress')!;

  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('border-accent'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('border-accent'));
  uploadZone.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    uploadZone.classList.remove('border-accent');
    if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files) handleFiles(fileInput.files);
  });

  async function handleFiles(files: FileList) {
    if (!currentEvent) return;
    progressEl.classList.remove('hidden');

    const existingAssets = await convex.query(api.media.listByEvent, { eventId: id as any });
    let sortOrder = existingAssets.length;

    for (const file of Array.from(files)) {
      const progressItem = document.createElement('div');
      progressItem.className = 'flex items-center gap-3 text-sm';
      progressItem.innerHTML = `
        <div class="h-1.5 flex-1 rounded-full bg-border overflow-hidden">
          <div class="h-full w-0 bg-accent transition-all" data-progress-bar></div>
        </div>
        <span class="text-xs text-text-muted w-20 truncate">${file.name}</span>
        <span class="text-xs text-text-muted" data-status>Uploading...</span>
      `;
      progressEl.appendChild(progressItem);

      const bar = progressItem.querySelector('[data-progress-bar]') as HTMLElement;
      const statusEl = progressItem.querySelector('[data-status]') as HTMLElement;

      try {
        // Default session token — no JWT template required for upload auth
        const token: string = clerkSession
          ? (await (clerkSession as any).getToken({ skipCache: false })) ?? ''
          : '';

        bar.style.width = '20%';

        const [uploaded] = await uploadFiles('eventMediaUploader', {
          files: [file],
          headers: token ? { Authorization: `Bearer ${token}` } : {},
          onUploadProgress: ({ progress }: { progress: number }) => {
            bar.style.width = `${20 + Math.round(progress * 0.7)}%`;
          },
        });

        bar.style.width = '100%';

        await convex.mutation(api.media.registerUpload, {
          eventId: id as any,
          uploadthingKey: uploaded.key,
          uploadthingUrl: (uploaded as any).ufsUrl ?? uploaded.url,
          filename: file.name,
          mimeType: file.type,
          sizeBytes: file.size,
          sortOrder: sortOrder++,
        });

        statusEl.textContent = 'Done';
      } catch {
        statusEl.textContent = 'Failed';
        bar.classList.replace('bg-accent', 'bg-red-500');
      }
    }

    fileInput.value = '';
    setTimeout(() => {
      progressEl.innerHTML = '';
      progressEl.classList.add('hidden');
    }, 3000);
  }

  // ── Library: Add from UploadThing ────────────────────────────────────────

  const libraryToggle = document.getElementById('library-toggle')!;
  const libraryChevron = document.getElementById('library-chevron')!;
  const librarySection = document.getElementById('library-section')!;
  const libraryGrid = document.getElementById('library-grid')!;
  const libraryLoading = document.getElementById('library-loading')!;
  const libraryEmpty = document.getElementById('library-empty')!;
  const libraryAddBtn = document.getElementById('library-add-btn')!;
  const libraryCount = document.getElementById('library-selected-count')!;

  const selectedKeys = new Set<string>();
  let libraryLoaded = false;

  type LibraryFile = { key: string; name: string; size: number; mimeType: string; url: string; uploadedAt: number };

  function updateLibrarySelection() {
    const count = selectedKeys.size;
    if (count > 0) {
      libraryAddBtn.classList.remove('hidden');
      libraryCount.classList.remove('hidden');
      libraryCount.textContent = `${count} file${count !== 1 ? 's' : ''} selected`;
    } else {
      libraryAddBtn.classList.add('hidden');
      libraryCount.classList.add('hidden');
    }
  }

  async function loadLibrary() {
    if (libraryLoaded) return;
    libraryLoaded = true;
    libraryLoading.classList.remove('hidden');

    const token: string = clerkSession
      ? (await (clerkSession as any).getToken({ skipCache: false })) ?? ''
      : '';

    try {
      const res = await fetch('/api/uploadthing-files', {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (!res.ok) throw new Error('Failed to load library');
      const files: LibraryFile[] = await res.json();

      libraryLoading.classList.add('hidden');

      if (files.length === 0) {
        libraryEmpty.classList.remove('hidden');
        return;
      }

      libraryGrid.innerHTML = files.map((f) => {
        const isVideo = f.mimeType.startsWith('video/');
        const thumb = isVideo
          ? `<div class="absolute inset-0 bg-primary/10 flex items-center justify-center"><svg class="size-6 text-primary/40" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>`
          : `<img src="${f.url}" alt="${f.name}" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />`;
        return `
          <div
            class="library-item group relative aspect-square overflow-hidden rounded-lg bg-surface cursor-pointer border-2 border-transparent transition-all hover:border-accent"
            data-key="${f.key}"
            data-name="${f.name}"
            data-mime="${f.mimeType}"
            data-size="${f.size}"
            data-url="${f.url}"
            title="${f.name}"
          >
            ${thumb}
            <div class="check-indicator absolute top-1 right-1 hidden h-5 w-5 items-center justify-center rounded-full bg-accent text-accent-fg">
              <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
          </div>
        `;
      }).join('');

      libraryGrid.querySelectorAll('.library-item').forEach((el) => {
        el.addEventListener('click', () => {
          const key = (el as HTMLElement).dataset.key!;
          if (selectedKeys.has(key)) {
            selectedKeys.delete(key);
            el.classList.remove('border-accent', 'ring-2', 'ring-accent');
            (el.querySelector('.check-indicator') as HTMLElement).classList.add('hidden');
            (el.querySelector('.check-indicator') as HTMLElement).classList.remove('flex');
          } else {
            selectedKeys.add(key);
            el.classList.add('border-accent', 'ring-2', 'ring-accent');
            (el.querySelector('.check-indicator') as HTMLElement).classList.remove('hidden');
            (el.querySelector('.check-indicator') as HTMLElement).classList.add('flex');
          }
          updateLibrarySelection();
        });
      });
    } catch {
      libraryLoading.classList.add('hidden');
      libraryEmpty.textContent = 'Failed to load library.';
      libraryEmpty.classList.remove('hidden');
    }
  }

  libraryToggle.addEventListener('click', () => {
    const isOpen = libraryToggle.getAttribute('aria-expanded') === 'true';
    libraryToggle.setAttribute('aria-expanded', String(!isOpen));
    librarySection.classList.toggle('hidden', isOpen);
    libraryChevron.style.transform = isOpen ? '' : 'rotate(90deg)';
    if (!isOpen) loadLibrary();
  });

  libraryAddBtn.addEventListener('click', async () => {
    if (selectedKeys.size === 0 || !currentEvent) return;
    (libraryAddBtn as HTMLButtonElement).disabled = true;
    libraryAddBtn.textContent = 'Adding...';

    const existingAssets = await convex.query(api.media.listByEvent, { eventId: id as any });
    let sortOrder = existingAssets.length;

    for (const key of Array.from(selectedKeys)) {
      const el = libraryGrid.querySelector(`[data-key="${key}"]`) as HTMLElement;
      if (!el) continue;
      await convex.mutation(api.media.registerUpload, {
        eventId: id as any,
        uploadthingKey: el.dataset.key!,
        uploadthingUrl: el.dataset.url!,
        filename: el.dataset.name!,
        mimeType: el.dataset.mime!,
        sizeBytes: Number(el.dataset.size ?? 0),
        sortOrder: sortOrder++,
      });
    }

    selectedKeys.clear();
    updateLibrarySelection();
    (libraryAddBtn as HTMLButtonElement).disabled = false;
    libraryAddBtn.textContent = 'Add Selected to Event';
    libraryGrid.querySelectorAll('.library-item').forEach((el) => {
      el.classList.remove('border-accent', 'ring-2', 'ring-accent');
      (el.querySelector('.check-indicator') as HTMLElement).classList.add('hidden');
      (el.querySelector('.check-indicator') as HTMLElement).classList.remove('flex');
    });
  });
</script>
