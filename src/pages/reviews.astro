---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';

const reviews = [
  { quote: 'The photos from my son\'s tournament were absolutely incredible. Every parent on the team ordered prints. 1822 Media captured moments we\'ll treasure forever.', name: 'Sarah M.', role: 'Parent, U14 Team', rating: 5 },
  { quote: 'We use 1822 Media for all of our home games. The turnaround is fast and the quality is professional. Our players love seeing themselves in action.', name: 'Coach Rivera', role: 'Head Coach, 1822 Lacrosse', rating: 5 },
  { quote: 'My daughter got a scholarship offer and her highlight video from 1822 Media was a huge part of that. The editing is top notch.', name: 'James T.', role: 'Parent, Club Player', rating: 5 },
  { quote: 'Easy to access, easy to download. The gallery system is so much better than just getting a link to a Google Drive. Love the access code setup.', name: 'Melissa C.', role: 'Team Manager', rating: 5 },
  { quote: 'Best lacrosse photography we\'ve had in 5 years of playing club. Sharp images, great angles, and they actually capture the game — not just posed shots.', name: 'David & Karen P.', role: 'Parents, Twin Players', rating: 5 },
  { quote: 'The branded graphics for our tournament program were fire. Our players were hyped to see themselves on the cover. Will 100% book again.', name: 'Marcus W.', role: 'Club Director', rating: 5 },
];
---

<BaseLayout
  title="Reviews"
  description={`Read reviews from 1822 Lacrosse families and coaches about ${brand.name} photography services.`}
>
  <Header slot="header" />

  <div class="bg-primary text-primary-fg py-12 px-4 sm:px-6">
    <div class="mx-auto max-w-site">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent font-heading">Testimonials</p>
      <h1 class="mt-2 text-h1 font-heading font-bold uppercase">What Families Say</h1>
    </div>
  </div>

  <section class="py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Trusted by 1822 Lacrosse families</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Here's what players, parents, and coaches say about 1822 Media.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {reviews.map(({ quote, name, role, rating }) => (
          <div class="flex flex-col rounded-xl border border-border bg-background p-6 shadow-sm">
            <div class="mb-4 flex gap-0.5" aria-label={`Rated ${rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class:list={['size-5', i < rating ? 'text-accent' : 'text-border']}
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="flex-1 text-text-muted leading-relaxed">
              &ldquo;{quote}&rdquo;
            </blockquote>
            <div class="mt-4 border-t border-border pt-4">
              <p class="font-semibold text-text">{name}</p>
              <p class="text-sm text-text-muted">{role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary py-16">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <h2 class="text-h2 font-heading font-bold uppercase text-primary-fg">See the galleries for yourself</h2>
      <a href="/gallery" class="mt-8 inline-flex min-h-[52px] items-center rounded-md bg-accent px-10 py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90">
        Browse Galleries
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
