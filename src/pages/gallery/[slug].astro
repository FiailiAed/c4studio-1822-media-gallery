---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { brand } from '../../config/brand';

const { slug } = Astro.params;
---

<BaseLayout title={`Gallery — ${brand.name}`} description="View and download event photos. Enter your team access code to unlock full resolution images.">
  <Header slot="header" />

  <section class="min-h-screen bg-surface" data-slug={slug}>
    <!-- Event header (populated by JS) -->
    <div id="event-header" class="bg-primary text-primary-fg py-12 px-4 sm:px-6">
      <div class="mx-auto max-w-site">
        <div id="event-header-skeleton" class="animate-pulse space-y-3">
          <div class="h-4 w-32 rounded bg-primary-fg/20"></div>
          <div class="h-8 w-64 rounded bg-primary-fg/20"></div>
          <div class="h-4 w-48 rounded bg-primary-fg/20"></div>
        </div>
        <div id="event-header-content" class="hidden">
          <p class="font-heading text-sm font-semibold uppercase tracking-widest text-accent" id="event-date"></p>
          <h1 class="mt-2 text-h1 font-heading font-bold uppercase" id="event-title"></h1>
          <p class="mt-2 text-lead text-primary-fg/70" id="event-location"></p>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-site px-4 py-10 sm:px-6">

      <!-- Access code gate (shown when locked) -->
      <div id="access-gate" class="hidden">
        <div class="mx-auto max-w-md rounded-xl border border-border bg-background p-8 text-center shadow-sm">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
            <svg class="size-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h2 class="text-h3 font-heading font-bold uppercase text-primary">Gallery Locked</h2>
          <p class="mt-2 text-sm text-text-muted">Enter your team access code to view and download photos.</p>

          <form id="access-code-form" class="mt-6">
            <input
              id="access-code-input"
              type="text"
              placeholder="Enter access code"
              maxlength="16"
              autocomplete="off"
              autocapitalize="characters"
              class="w-full rounded-md border border-border bg-surface px-4 py-3 text-center font-heading text-lg font-bold uppercase tracking-widest text-primary placeholder:text-text-muted/50 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
            />
            <p id="code-error" class="mt-2 hidden text-sm text-red-600"></p>
            <button
              type="submit"
              class="mt-4 w-full rounded-md bg-accent py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90 disabled:opacity-50"
            >
              Unlock Gallery
            </button>
          </form>

          <div id="paid-cta" class="mt-6 hidden border-t border-border pt-6">
            <p class="text-sm text-text-muted">Don't have a code?</p>
            <a id="purchase-link" href="#" class="mt-2 inline-block text-sm font-semibold text-primary hover:underline">
              Purchase Access
            </a>
          </div>
        </div>

        <!-- Watermarked preview grid -->
        <div class="mt-10">
          <p class="mb-4 text-center text-sm text-text-muted">Preview (watermarked)</p>
          <div id="preview-grid" class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4"></div>
        </div>
      </div>

      <!-- Full gallery (shown when unlocked) -->
      <div id="full-gallery" class="hidden">
        <div class="mb-6 flex items-center justify-between">
          <p class="text-sm text-text-muted"><span id="photo-count"></span> photos</p>
          <button
            id="lock-gallery"
            class="text-xs text-text-muted hover:text-primary transition-colors"
          >
            Lock gallery
          </button>
        </div>
        <div id="media-grid" class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4"></div>
      </div>

      <!-- Loading state -->
      <div id="gallery-loading" class="flex items-center justify-center py-20">
        <div class="h-8 w-8 animate-spin rounded-full border-4 border-border border-t-accent"></div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import { ConvexClient } from 'convex/browser';
  import { api } from '../../../convex/_generated/api';

  const slug = (document.querySelector('section[data-slug]') as HTMLElement)?.dataset.slug ?? '';
  const convex = new ConvexClient(import.meta.env.PUBLIC_CONVEX_URL);

  const STORAGE_KEY = `1822_access_${slug}`;

  const els = {
    headerSkeleton: document.getElementById('event-header-skeleton'),
    headerContent: document.getElementById('event-header-content'),
    eventDate: document.getElementById('event-date'),
    eventTitle: document.getElementById('event-title'),
    eventLocation: document.getElementById('event-location'),
    accessGate: document.getElementById('access-gate'),
    fullGallery: document.getElementById('full-gallery'),
    loading: document.getElementById('gallery-loading'),
    codeForm: document.getElementById('access-code-form'),
    codeInput: document.getElementById('access-code-input'),
    codeError: document.getElementById('code-error'),
    paidCta: document.getElementById('paid-cta'),
    purchaseLink: document.getElementById('purchase-link'),
    previewGrid: document.getElementById('preview-grid'),
    mediaGrid: document.getElementById('media-grid'),
    photoCount: document.getElementById('photo-count'),
    lockBtn: document.getElementById('lock-gallery'),
  };

  let currentEventId = null;

  function formatDate(ts) {
    return new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(ts));
  }

  function showLoading() {
    els.loading.classList.remove('hidden');
    els.accessGate.classList.add('hidden');
    els.fullGallery.classList.add('hidden');
  }

  function showGate(event) {
    els.loading.classList.add('hidden');
    els.accessGate.classList.remove('hidden');
    els.fullGallery.classList.add('hidden');

    if (!event.isFree) {
      els.paidCta.classList.remove('hidden');
      els.purchaseLink.href = `/gallery/${slug}/checkout`;
    }

    convex.query(api.media.listWatermarkedPreviews, { eventId: currentEventId }, (previews) => {
      if (!previews || previews.length === 0) {
        els.previewGrid.innerHTML = '<p class="col-span-full text-center text-sm text-text-muted">No preview images yet.</p>';
        return;
      }
      els.previewGrid.innerHTML = previews.map(p => `
        <div class="relative aspect-square overflow-hidden rounded-lg bg-surface">
          <img src="${p.watermarkedUrl}" alt="Preview" class="absolute inset-0 h-full w-full object-cover blur-sm brightness-75" loading="lazy" />
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="size-8 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
        </div>
      `).join('');
    });
  }

  function showGallery(assets) {
    els.loading.classList.add('hidden');
    els.accessGate.classList.add('hidden');
    els.fullGallery.classList.remove('hidden');
    els.photoCount.textContent = String(assets.length);

    if (assets.length === 0) {
      els.mediaGrid.innerHTML = '<p class="col-span-full text-center text-text-muted py-10">No photos have been added yet.</p>';
      return;
    }

    els.mediaGrid.innerHTML = assets.map(asset => {
      const isVideo = asset.mimeType?.startsWith('video/');
      const thumb = isVideo
        ? `<div class="absolute inset-0 bg-primary/20 flex items-center justify-center">
             <svg class="size-12 text-white/80" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
           </div>`
        : `<img src="${asset.uploadthingUrl}" alt="${asset.filename}" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />`;

      return `
        <div class="group relative aspect-square overflow-hidden rounded-lg bg-surface">
          ${thumb}
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-end justify-center pb-3 opacity-0 group-hover:opacity-100">
            <a
              href="${asset.uploadthingUrl}"
              download="${asset.filename}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md bg-accent px-3 py-1.5 text-xs font-bold text-accent-fg shadow"
              aria-label="Download ${asset.filename}"
            >
              <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download
            </a>
          </div>
        </div>
      `;
    }).join('');
  }

  async function unlockGallery(code) {
    const assets = await convex.query(api.media.listByEvent, { eventId: currentEventId });
    localStorage.setItem(STORAGE_KEY, code);
    showGallery(assets);
  }

  async function init() {
    const event = await convex.query(api.events.getBySlug, { slug });

    if (!event) {
      els.headerSkeleton.classList.add('hidden');
      els.headerContent.classList.remove('hidden');
      els.eventTitle.textContent = 'Event not found';
      els.loading.classList.add('hidden');
      return;
    }

    currentEventId = event._id;

    // Populate header
    els.headerSkeleton.classList.add('hidden');
    els.headerContent.classList.remove('hidden');
    els.eventDate.textContent = formatDate(event.eventDate);
    els.eventTitle.textContent = event.title;
    els.eventLocation.textContent = event.location ?? '';

    // Check stored code
    const storedCode = localStorage.getItem(STORAGE_KEY);
    if (storedCode) {
      const result = await convex.query(api.accessCodes.check, { code: storedCode, eventId: currentEventId });
      if (result.valid) {
        const assets = await convex.query(api.media.listByEvent, { eventId: currentEventId });
        showGallery(assets);
        return;
      } else {
        localStorage.removeItem(STORAGE_KEY);
      }
    }

    // Free events: auto-unlock without code
    if (event.isFree) {
      const assets = await convex.query(api.media.listByEvent, { eventId: currentEventId });
      showGallery(assets);
      return;
    }

    showGate(event);
  }

  // Access code form submission
  els.codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = els.codeInput.value.trim().toUpperCase();
    if (!code) return;

    els.codeError.classList.add('hidden');
    const btn = els.codeForm.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = 'Checking...';

    try {
      await convex.mutation(api.accessCodes.redeemCode, { code, eventId: currentEventId });
      await unlockGallery(code);
    } catch (err) {
      const msg = err?.message ?? 'invalid_code';
      const messages = {
        invalid_code: 'Invalid access code. Please check and try again.',
        revoked: 'This access code has been revoked.',
        expired: 'This access code has expired.',
        max_uses: 'This access code has reached its maximum uses.',
      };
      els.codeError.textContent = messages[msg] ?? 'Invalid code. Please try again.';
      els.codeError.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Unlock Gallery';
    }
  });

  // Lock button
  els.lockBtn.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    location.reload();
  });

  init();
</script>
