---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { brand } from '../../../config/brand';

const { slug } = Astro.params;
const sessionId = Astro.url.searchParams.get('session_id') ?? '';
---

<BaseLayout title={`Purchase Complete — ${brand.name}`} description="Your access code is ready.">
  <Header slot="header" />

  <section class="min-h-screen bg-surface py-16">
    <div class="mx-auto max-w-lg px-4 sm:px-6">
      <div class="rounded-xl border border-border bg-background p-8 text-center shadow-sm">

        <div id="loading-state" class="py-8">
          <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-border border-t-accent"></div>
          <p class="mt-4 text-sm text-text-muted">Retrieving your access code...</p>
        </div>

        <div id="success-state" class="hidden">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-accent/20">
            <svg class="size-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h1 class="mt-4 text-h2 font-heading font-bold uppercase text-primary">Payment Complete!</h1>
          <p class="mt-2 text-text-muted">Your access code is below. Save it — you'll need it to view the gallery.</p>

          <div class="mt-6 rounded-lg border-2 border-accent bg-surface px-6 py-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-text-muted">Your Access Code</p>
            <p id="access-code-display" class="mt-1 font-heading text-3xl font-bold uppercase tracking-widest text-primary"></p>
          </div>

          <button
            id="copy-code-btn"
            class="mt-3 text-xs text-text-muted hover:text-primary transition-colors"
          >
            Copy code
          </button>

          <a
            id="view-gallery-link"
            href={`/gallery/${slug}`}
            class="mt-6 block w-full rounded-md bg-accent py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90"
          >
            View Gallery
          </a>
          <p class="mt-4 text-xs text-text-muted">Enter this code on the gallery page to unlock your photos.</p>
        </div>

        <div id="error-state" class="hidden py-8">
          <p class="text-text-muted">Could not retrieve your access code. Please contact <a href="mailto:1822lax@gmail.com" class="text-primary underline">1822lax@gmail.com</a> with your order reference.</p>
          <a href={`/gallery/${slug}`} class="mt-4 inline-block text-sm font-semibold text-primary hover:underline">Return to gallery</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script define:vars={{ sessionId, slug }}>
  import { ConvexClient } from 'convex/browser';
  import { api } from '../../../../convex/_generated/api';

  const convex = new ConvexClient(import.meta.env.PUBLIC_CONVEX_URL);

  async function init() {
    if (!sessionId) {
      document.getElementById('loading-state').classList.add('hidden');
      document.getElementById('error-state').classList.remove('hidden');
      return;
    }

    // Poll for purchase record (webhook may take a moment)
    let attempts = 0;
    const maxAttempts = 20;
    const poll = async () => {
      const result = await convex.query(api.purchases.getBySession, { sessionId });
      if (result?.code) {
        document.getElementById('loading-state').classList.add('hidden');
        document.getElementById('success-state').classList.remove('hidden');
        document.getElementById('access-code-display').textContent = result.code.code;

        document.getElementById('copy-code-btn').addEventListener('click', () => {
          navigator.clipboard.writeText(result.code.code);
          document.getElementById('copy-code-btn').textContent = 'Copied!';
          setTimeout(() => {
            document.getElementById('copy-code-btn').textContent = 'Copy code';
          }, 2000);
        });
      } else if (attempts < maxAttempts) {
        attempts++;
        setTimeout(poll, 1500);
      } else {
        document.getElementById('loading-state').classList.add('hidden');
        document.getElementById('error-state').classList.remove('hidden');
      }
    };

    poll();
  }

  init();
</script>
